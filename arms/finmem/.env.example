# Copy to .env and fill in the real values. .env is gitignored; this file is the
# only .env* that is ever committed. The entrypoint refuses to start while either
# key is missing or still REPLACE_ME (override with FP_REQUIRE_KEYS=0 for a
# key-less shell, e.g. to run the scorer or the tests).

# The model under test. FinMem reads OPENAI_API_KEY; the entrypoint bridges this
# to it so the key lives in exactly one place.
BACKBONE_API_KEY=REPLACE_ME
# A DATED snapshot, never a floating alias: a mid-run alias re-point splits the
# run across two model versions and costs every row from the older one.
BACKBONE_MODEL=gpt-5.4-mini-2026-03-17

# The paraphrase provider for N1 variants. Must be a DIFFERENT provider from the
# backbone, or the rewrites inherit the backbone's own phrasing and N1 stops
# being an independent perturbation. The entrypoint warns if the keys match.
PARAPHRASE_API_KEY=REPLACE_ME
# Recorded in the container banner; the paraphraser is not yet wired.
PARAPHRASE_MODEL=REPLACE_ME
